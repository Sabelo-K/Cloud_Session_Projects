# Copy to .env for local runs (`cp .env.example .env`). .env is git-ignored.
# In GitHub Actions these are repository secrets instead:
#   Settings -> Secrets and variables -> Actions -> New repository secret

# --- Phase 1 (required to send; not needed for --dry-run) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your chat id (see README step 2)
TELEGRAM_CHAT_ID=

# --- Optional ---
# DEBUG shows raw fetched values per source. INFO is the default.
LOG_LEVEL=INFO

# --- Added in later phases (listed now so this file stays the single source of truth) ---
# Phase 2, YouTube Data API v3 key (API key only, no OAuth)
# YOUTUBE_API_KEY=
